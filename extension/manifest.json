{
  "manifest_version": 3,
  "name": "Quick Download",
  "version": "1.0.0",
  "description": "Detects video, audio and image files on any page and hands them to the local Quick Download engine for multi-connection downloading.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Download",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webRequest",
    "storage",
    "tabs",
    "cookies",
    "contextMenus",
    "downloads",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },

  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "media_ruleset",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  }
}